# Local-server config. Copy to .env and set real values.
# Server binds to all LAN interfaces so phones on the same WiFi can open it.

# Required on event day: staff PIN for /verify check-in + /admin
STAFF_PIN=mirdc2026
# Optional: separate admin PIN (defaults to STAFF_PIN)
ADMIN_PIN=mirdc2026

# Optional: override sqlite path (default ./data/attendees.db)
# DB_PATH=./data/attendees.db

# Port (default 3000)
PORT=3000

# Mailer middleware (MIRDC email gateway — POST /sendMail).
# Best-effort only: registration succeeds even if email fails.
# The event server must reach this host (same intranet/LAN).
MAILER_URL=http://10.10.120.43:3232/sendMail
# Only needed if the gateway sets MIDDLEWARE_API_KEY:
MAILER_API_KEY=
SMTP_FROM=fad-agss@mirdc.dost.gov.ph
SMTP_FROM_NAME=DOST-MIRDC 3D Printing Registration
# Public base URL of THIS system — used for verify links in emails.
# MUST be reachable by guests' phones (their browser + Gmail image/link).
# This server's LAN IP is 10.10.123.40 — update if it changes.
APP_URL=http://10.10.123.40:3000
